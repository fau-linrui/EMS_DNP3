{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dnp3-master/simulator-settings.schema.json",
  "title": "SIMULATOR-only basic pytest settings v1",
  "description": "Loader also enforces unique IDs and kind/index pairs, reference consistency, distinct link addresses, retry ordering and class counts within max_measurements. No time synchronization, Restart or signal generation.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "environment", "connection", "points", "controls", "events"],
  "properties": {
    "schema_version": {"const": 1}, "environment": {"const": "SIMULATOR"},
    "runtime_root": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096},
    "connection": {"$ref": "#/$defs/connection"},
    "task_timeout": {"type": "number", "minimum": 0.1, "maximum": 60},
    "feedback_timeout": {"type": "number", "minimum": 0.1, "maximum": 300},
    "event_timeout": {"type": "number", "minimum": 0.1, "maximum": 3600},
    "max_measurements": {"type": "integer", "minimum": 1, "maximum": 65536},
    "points": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/point"}},
    "controls": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/control"}},
    "events": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/event"}},
    "class_counts": {"type": "array", "maxItems": 3, "items": {
      "type": "object", "additionalProperties": false, "required": ["class", "count"],
      "properties": {"class": {"type": "integer", "minimum": 1, "maximum": 3}, "count": {"type": "integer", "minimum": 0, "maximum": 65536}}
    }}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
    "index": {"type": "integer", "minimum": 0, "maximum": 65535},
    "value": {"oneOf": [{"type": "boolean"}, {"type": "number", "minimum": -3.4028234663852886e38, "maximum": 3.4028234663852886e38}]},
    "tolerance": {"type": "number", "minimum": 0, "maximum": 1e30},
    "connection": {
      "type": "object", "additionalProperties": false, "required": ["host"],
      "properties": {
        "host": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[!-~]+$"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "local_adapter": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[!-~]+$"},
        "master_address": {"type": "integer", "minimum": 0, "maximum": 65519},
        "outstation_address": {"type": "integer", "minimum": 0, "maximum": 65519},
        "connect_timeout": {"type": "number", "minimum": 0.05, "maximum": 300},
        "retry_min": {"type": "number", "minimum": 0.01, "maximum": 300},
        "retry_max": {"type": "number", "minimum": 0.01, "maximum": 300},
        "keep_alive_timeout": {"type": "number", "minimum": 1, "maximum": 86400}
      }
    },
    "point": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "index"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["BI", "AI", "BO", "AO"]}, "index": {"$ref": "#/$defs/index"},
        "expected": {"oneOf": [{"$ref": "#/$defs/value"}, {"type": "null"}]}, "tolerance": {"$ref": "#/$defs/tolerance"},
        "required_flags": {"type": ["integer", "null"], "minimum": 0, "maximum": 255}
      },
      "allOf": [{"if": {"properties": {"kind": {"enum": ["BI", "BO"]}}}, "then": {"properties": {"expected": {"type": ["boolean", "null"]}}}, "else": {"properties": {"expected": {"type": ["number", "null"]}}}}]
    },
    "control": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "index", "feedback_point", "value"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["BO", "AO"]}, "index": {"$ref": "#/$defs/index"},
        "feedback_point": {"$ref": "#/$defs/id"}, "value": {"$ref": "#/$defs/value"}, "expected": {"$ref": "#/$defs/value"}, "tolerance": {"$ref": "#/$defs/tolerance"}
      },
      "allOf": [{"if": {"properties": {"kind": {"const": "BO"}}}, "then": {"properties": {"value": {"type": "boolean"}, "expected": {"type": "boolean"}}}, "else": {"properties": {"value": {"type": "number"}, "expected": {"type": "number"}}}}]
    },
    "event": {
      "type": "object", "additionalProperties": false, "required": ["id", "point", "expected"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "point": {"$ref": "#/$defs/id"}, "expected": {"$ref": "#/$defs/value"},
        "tolerance": {"$ref": "#/$defs/tolerance"}, "require_timestamp": {"type": "boolean"}, "require_change": {"type": "boolean"}
      }
    }
  }
}
