{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ems-dnp3/local-event-profile.schema.json",
  "title": "Deterministic loopback event load profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "profile_id", "scope", "outstation_point_count",
    "event_buffer_capacity", "loads"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "scope": { "const": "LOCAL_LOOPBACK_ONLY" },
    "outstation_point_count": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "event_buffer_capacity": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "loads": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/load" }
    }
  },
  "$defs": {
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id", "point_type", "event_count", "iterations", "seed",
        "start_sequence", "timestamp_base_ms", "point_span", "interval_us",
        "capture_duration_seconds", "completion_timeout_seconds", "queue_capacity",
        "max_elapsed_seconds", "max_cpu_core_percent"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "point_type": { "enum": ["binary_input", "analog_input"] },
        "event_count": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "iterations": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "start_sequence": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "timestamp_base_ms": { "type": "integer", "minimum": 0, "maximum": 281474976710655 },
        "point_span": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "interval_us": { "type": "integer", "minimum": 0, "maximum": 55000000 },
        "capture_duration_seconds": { "type": "number", "minimum": 0.1, "maximum": 604800 },
        "completion_timeout_seconds": { "type": "number", "minimum": 0.1, "maximum": 300 },
        "queue_capacity": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "max_elapsed_seconds": { "type": "number", "minimum": 0.001, "maximum": 604800 },
        "max_cpu_core_percent": { "type": "number", "minimum": 0.001, "maximum": 1000000 }
      }
    }
  }
}
